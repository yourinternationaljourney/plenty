# Plenty recipe service (server/index.js). Copy to .env and fill in.
# The published Claude artifact cannot reach the internet, so live recipes and URL import
# only work when plenty.html is served next to this service (see PLAN.md, section 10).

# Enables live external recipes in Discover. Without it the app uses the built-in starter recipes
# and clearly says so. Get a key at https://spoonacular.com/food-api (free developer tier, points per day).
SPOONACULAR_API_KEY=

# Which recipe provider the service exposes: spoonacular (default) or none.
RECIPE_PROVIDER=spoonacular

# Origin allowed to call this service (the page that hosts plenty.html), e.g. http://localhost:8080
PLENTY_ALLOWED_ORIGIN=http://localhost:8080

# Port for the service. The page is pointed at it from Settings > Live recipe service URL.
PORT=8787

# URL import: fetches a recipe page server-side and returns only Schema.org Recipe JSON-LD.
# Set to false to disable the import endpoint.
ENABLE_URL_IMPORT=true
